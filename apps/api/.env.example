# --- DeepSeek (必填) ---
DEEPSEEK_API_KEY=sk-...

# 可选覆盖
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL_CHAT=deepseek-chat
# DEEPSEEK_MODEL_REASONER=deepseek-reasoner
# DEEPSEEK_MAX_TOKENS=4096
# DEEPSEEK_TIMEOUT_SECONDS=60
# DEEPSEEK_RETRY_MAX=2

# --- Supabase (可选；不填则不持久化生成历史；v1.1 起若启用 RAG 必填) ---
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJ...

# --- Embedding / RAG (v1.1 可选；不填则回退到 v1.0 硬编码方法论) ---
# 默认走智谱 BigModel（OpenAI 兼容协议）。可换 OpenAI / 阿里 / 其它兼容供应商。
# EMBEDDING_API_KEY=...
# EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# EMBEDDING_MODEL=embedding-3
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_TIMEOUT_SECONDS=20
# RAG_TOP_K=8
# RAG_MIN_SIMILARITY=0.30

# --- CORS (生产建议填具体域名，逗号分隔) ---
# CORS_ALLOW_ORIGINS=https://your-domain.com,https://www.your-domain.com
